{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-dash-preview",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets"
  },
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "DASH_FEEDS",
      "id": "REPLACE_WITH_PREVIEW_KV_ID"
    }
  ],
  "workers_dev": true
}
