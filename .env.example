# Copy to .env.local. Never commit tokens. Restart LifeDash after changing config.
# Weather: defaults to Chicago; set both coordinates and the display name.
LIFEDASH_LATITUDE=41.8781
LIFEDASH_LONGITUDE=-87.6298
LIFEDASH_LOCATION=Chicago
WEATHER_UNIT=F

# Optional GitHub: username enables public activity; a token adds private scope. A fine-grained token needs access to selected
# repositories and their metadata/pull requests; a classic token may need repo
# for private repository contributions. All credentials remain server-side.
GITHUB_TOKEN=
GITHUB_USERNAME=

# HTTP checks expect 2xx. No login flow or credentials in URLs.
# Example: [{"name":"VPS","url":"https://your-host.example/health","timeoutMs":5000}]
SYSTEM_HEALTH_ENDPOINTS=[]
LIFEDASH_MACHINE_NAME=Mac

# IANA timezone, local to your display. All clocks, events, modes and GitHub
# day boundaries use this timezone.
TIMEZONE=America/Chicago
MORNING_START=6
DAY_START=9
EVENING_START=17
NIGHT_START=22
ROTATION_SECONDS=25
LIFEDASH_DEMO=false

# Server-side cache intervals. Browser checks the normalized API every 30s.
REFRESH_WEATHER_SECONDS=900
REFRESH_SYSTEMS_SECONDS=45
REFRESH_BUILD_SECONDS=180
REFRESH_CALENDAR_SECONDS=120
REFRESH_REMINDERS_SECONDS=120
REFRESH_HABITS_SECONDS=120
REFRESH_FINANCE_SECONDS=1800
REFRESH_HEALTH_SECONDS=600
REFRESH_AI_SECONDS=180
REFRESH_GOALS_SECONDS=600

# Planned adapters only; these variables do not enable integrations yet.
# APPLE_BRIDGE_URL=
# APPLE_BRIDGE_TOKEN=
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# HOME_ASSISTANT_URL=
# HOME_ASSISTANT_TOKEN=

# Local read-only Codex quota telemetry; auto-detects the macOS ChatGPT app.
# CODEX_BINARY=/absolute/path/to/codex
# Optional normalized Cursor/Grok Bot snapshot; defaults to .lifedash/ai-usage.json.
# AI_USAGE_PATH=/absolute/path/to/ai-usage.json
# EventKit bridge snapshot, created by npm run bridge:apple on macOS.
# APPLE_BRIDGE_PATH=/absolute/path/to/apple-bridge.json

# Exact native calendar names grouped as work. Others are personal.
WORK_CALENDARS=["Work"]
# Exact Apple Reminders list name used for recurring habits.
HABITS_LIST_NAME=Habits
# Generated by npm run health:pair after approving local HTTP sync; keep private.
# HEALTH_SYNC_TOKEN=
# Optional manual Health summary location.
# HEALTH_IMPORT_PATH=/absolute/path/to/health-import.json
